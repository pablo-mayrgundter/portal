+  /**
+   * Local-canvas WebGLRenderer: append a fresh canvas to `container` and
+   * construct a renderer around its webgl2 context. The default path —
+   * runs when celestiary is loaded as a standalone page.
+   *
+   * @returns {WebGLRenderer}
+   */
+  _initLocalRenderer(container) {
+    const canvas = document.createElement('canvas')
+    const ctx = canvas.getContext('webgl2')
+    container.appendChild(canvas)
+    return new WebGLRenderer({canvas: canvas, context: ctx, antialias: true})
+  }
+
+
+  /**
+   * Portal-mode WebGLRenderer: when celestiary is loaded inside a NetGL
+   * portal host (an iframe with `?portal=1`), construct a recorder-backed
+   * renderer whose every GL call ships over postMessage to the host. The
+   * host replays the call stream against its own WebGL2 canvas, with the
+   * portal door's pixel rect as the viewport. No local canvas painted.
+   *
+   * Returns null when not in portal mode — caller falls back to
+   * `_initLocalRenderer`.
+   *
+   * @returns {?WebGLRenderer}
+   */
+  _maybeNetGLPortalRenderer(backgroundColor) {
+    const inIframe = (() => {
+      try {return parent !== self} catch {return true}
+    })()
+    const portalMode = inIframe &&
+      new URLSearchParams(location.search).get('portal') === '1'
+    if (!portalMode) {
+      return null
+    }
+    const r = (backgroundColor >> 16) & 0xff
+    const g = (backgroundColor >> 8) & 0xff
+    const b = backgroundColor & 0xff
+    const {renderer} = makeNetGLPortalGuest({
+      WebGLRenderer,
+      anchor: PORTAL_ANCHOR,
+      background: {r: r / 255, g: g / 255, b: b / 255},
+      rendererParams: {antialias: true, stencil: true, depth: true},
+    })
+    return renderer
+  }
+
