+// Portal anchor: where the portal door sits in celestiary's coordinate
+// space when this page is embedded as a NetGL portal target. Centred at
+// the sun (origin), normal facing -z. Half-extents are roughly the
+// inner-solar-system scale so a host portal frames the planets cleanly;
+// this is the only celestiary-specific value the portal mode needs.
+const PORTAL_ANCHOR = {
+  position: [0, 0, 0],
+  normal: [0, 0, -1],
+  up: [0, 1, 0],
+  halfWidth: 5e10,
+  halfHeight: 5e10,
