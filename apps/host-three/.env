# Snapshot-proxy base URL used in og:image / twitter:image meta tags.
# Vite substitutes %VITE_SNAPSHOT_PROXY% in index.html and inlines
# import.meta.env.VITE_SNAPSHOT_PROXY in JS at build time.
#
# Override locally with apps/host-three/.env.local (gitignored by default
# in fresh Vite projects; this monorepo's .gitignore doesn't list .env*
# yet, so a .env.local you create stays out of git only if you keep it
# untracked).
VITE_SNAPSHOT_PROXY=https://portal-snapshot-proxy.fly.dev

# Optional. When set, press-P copies a permalink rooted at this URL instead
# of the current page's location. Used to point shared links at the share-
# proxy (which rewrites og:image based on ?pose=) so social previews on
# crawlers without JS show the pose-specific render. Leave unset for local
# dev so you keep getting localhost:5173 URLs in the clipboard.
VITE_SHARE_BASE=https://portal-share.fly.dev/
