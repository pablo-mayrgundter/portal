{
  "name": "portal-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:three",
    "dev:three": "npm run dev -w @portal/host-three",
    "dev:iframe": "npm run dev -w @portal/host-iframe-demo",
    "dev:netgl": "npm run dev -w @portal/host-netgl-demo",
    "dev:netgl-celestiary": "npm run dev -w @portal/host-netgl-celestiary",
    "setup:celestiary": "npm run setup-celestiary -w @portal/host-netgl-celestiary",
    "dev:worker": "npm run dev -w @portal/host-worker-demo",
    "dev:proxy": "npm run dev -w @portal/snapshot-proxy",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish:portal-netgl": "npm publish -w @pablo-mayrgundter/portal-netgl --access public"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  }
}

